{
  /*
      #############################################################################
      # DO NOT EDIT THIS FILE before reading the comments below:
      # This is the default configuration for Tiny Tapeout projects.
      #############################################################################
  */

  /* 'CLOCK_PERIOD' - Increase this in case you are getting setup time violations. */
  "CLOCK_PERIOD": 20,

  /* 'PL_TARGET_DENSITY_PCT' - You can increase this if Global Placement fails with error GPL-0302. */
  "PL_TARGET_DENSITY_PCT": 75,

  /* Hold slack margin */
  "PL_RESIZER_HOLD_SLACK_MARGIN": 0.1,
  "GLB_RESIZER_HOLD_SLACK_MARGIN": 0.05,

  /* RUN LINTER, LINTER INCLUDE PDK MODELS */
  "RUN_LINTER": 1,
  "LINTER_INCLUDE_PDK_MODELS": 1,

  /* ############################################################# */
  /* !!! DO NOT CHANGE ANYTHING BELOW THIS POINT !!! */
  /* ############################################################# */

  "RUN_KLAYOUT_XOR": 0,
  "RUN_KLAYOUT_DRC": 0,

  "DESIGN_REPAIR_BUFFER_OUTPUT_PORTS": 0,

  "FP_MARGIN_MULT": 1,
  "BOTTOM_MARGIN_MULT": 1,
  "LEFT_MARGIN_MULT": 6,
  "RIGHT_MARGIN_MULT": 6,

  "FP_SIZING": "absolute",

  "FP_IO_HLENGTH": 2,
  "FP_IO_VLENGTH": 2,

  "FP_PDN_VPITCH": 33.32,

  "RUN_CVC": 1,

  "FP_PDN_MULTILAYER": 0,
  "RT_MAX_LAYER": "met4",

  "MAGIC_DEF_LABELS": 0,
  "MAX_ROUTING_LAYER": "met4"
}
